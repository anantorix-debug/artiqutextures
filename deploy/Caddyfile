# Caddy obtains and renews HTTPS certificates automatically once DNS points at this server.
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy site:3002
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

admin.{$DOMAIN} {
	encode gzip zstd
	reverse_proxy crm:3000
}

api.{$DOMAIN} {
	encode gzip zstd
	request_body {
		max_size 30MB
	}
	reverse_proxy backend:3001
}
