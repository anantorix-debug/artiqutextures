# Copy to deploy/.env on the server and fill in. Generate secrets with: openssl rand -hex 32
DOMAIN=artiqusurface.com
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
# optional (password-reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# optional — WhatsApp anti-ban limits (defaults shown; see DEPLOYMENT.md "WhatsApp").
# This runs on the unofficial whatsapp-web.js, not Meta's Business API — these are
# what actually stand between the connected number and a ban, not a formality.
WHATSAPP_DAILY_MESSAGE_LIMIT=150
WHATSAPP_MIN_DELAY_SECONDS=4
WHATSAPP_MAX_JITTER_SECONDS=5
