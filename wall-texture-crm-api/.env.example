# ==============================
# Database
# ==============================
DATABASE_URL=

# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://192.168.1.4:3000,http://192.168.1.4:3002

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=30m

# ==============================
# Redis / BullMQ
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================
# SMTP (default fallback - overridable via Settings module)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Wall Texture CRM"
SMTP_FROM_EMAIL=

# ==============================
# File Uploads
# ==============================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ==============================
# WhatsApp (whatsapp-web.js runs in-process, session persisted to disk)
# ==============================
WHATSAPP_SESSION_DIR=whatsapp-sessions
WHATSAPP_SESSION_NAME=default

# ==============================
# Database Backup
# ==============================
BACKUP_DIR=backups
# Path to the mysqldump binary matching your running MySQL server.
# This machine runs MySQL via WAMP, not XAMPP — mysqldump isn't on PATH by
# default, so point directly at the binary for whichever server WAMP has
# active (check the WAMP tray icon > MySQL/MariaDB if you switch versions).
MYSQLDUMP_PATH=

# Pin a cached WhatsApp Web version (see .wwebjs_cache) if sending breaks after a WhatsApp update
WHATSAPP_WEB_VERSION=
